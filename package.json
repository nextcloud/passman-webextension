{
  "name": "passman-webextension-v3",
  "displayName": "Passman Webextension v3",
  "version": "0.0.1",
  "description": "A modern webextension for the Passman Nextcloud app",
  "author": "Timo Triebensky <timo@binsky.org>",
  "packageManager": "pnpm@8.10.2",
  "scripts": {
    "prebuild": "node ./assets/helper_scripts/update-tld-rules.js",
    "dev": "plasmo dev --verbose",
    "dev-ff": "plasmo dev --target=firefox-mv2",
    "build": "plasmo build",
    "build-ff": "plasmo build --target=firefox-mv2",
    "package": "plasmo package",
    "package-ff": "plasmo package --target=firefox-mv2"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.1",
    "@plasmohq/storage": "^1.15.0",
    "idb-keyval": "^6.2.1",
    "js-sha512": "^0.9.0",
    "plasmo": "^0.90.3",
    "regexparam": "^3.0.0",
    "svelte": "^4.2.19",
    "svelte-french-toast": "^1.2.0",
    "svelte-preprocess": "^5.1.4"
  },
  "devDependencies": {
    "@binsky/passman-client-ts": "^0.2.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@stylistic/eslint-plugin-ts": "^4.2.0",
    "@types/chrome": "^0.0.309",
    "@types/node": "^22.13.10",
    "@types/pouchdb": "^6.4.2",
    "@types/pouchdb-adapter-memory": "^6.1.6",
    "@types/pouchdb-find": "^7.3.3",
    "@typescript-eslint/parser": "^8.26.1",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "autoprefixer": "^10.4.21",
    "eslint-plugin-svelte": "^3.3.0",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "svelte-awesome": "3.3.4",
    "svelte-forms": "^2.3.1",
    "svelte-select": "^5.8.3",
    "svelte-time": "^0.9.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "default_locale": "en",
    "permissions": [
      "contextMenus"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/content_styles/*.css"
        ],
        "matches": [
          "http://*/*",
          "https://*/*"
        ]
      }
    ]
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "svelte-preprocess"
  ]
}
