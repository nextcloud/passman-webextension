{
  "name": "passman-webextension-v3",
  "displayName": "Passman Webextension v3",
  "version": "0.0.1",
  "description": "A modern webextension for the Passman Nextcloud app",
  "author": "Timo Triebensky <timo@binsky.org>",
  "packageManager": "pnpm@8.10.2",
  "scripts": {
    "dev": "plasmo dev --verbose",
    "dev-ff": "plasmo dev --target=firefox-mv2",
    "build": "plasmo build",
    "build-ff": "plasmo build --target=firefox-mv2",
    "package": "plasmo package",
    "package-ff": "plasmo package --target=firefox-mv2"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.6.2",
    "@plasmohq/storage": "^1.9.3",
    "js-sha512": "^0.9.0",
    "plasmo": "^0.85.2",
    "regexparam": "^2.0.2",
    "svelte": "^4.2.12",
    "svelte-french-toast": "^1.2.0",
    "svelte-preprocess": "^5.1.3"
  },
  "devDependencies": {
    "@binsky/passman-client-ts": "^0.1.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.2.1",
    "@types/chrome": "^0.0.258",
    "@types/node": "^20.12.5",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.2.2",
    "prettier-plugin-tailwindcss": "^0.5.13",
    "svelte-awesome": "^3.3.1",
    "svelte-forms": "^2.3.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.4"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "default_locale": "en"
  }
}
