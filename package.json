{
  "name": "passman-webextension-v3",
  "displayName": "Passman Webextension v3",
  "version": "0.3.0",
  "type": "module",
  "description": "A modern webextension for the Passman Nextcloud app",
  "author": "Timo Triebensky <timo@binsky.org>",
  "packageManager": "bun@1.3.1",
  "scripts": {
    "prebuild": "node public/helper_scripts/update-tld-rules.cjs",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv2",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check-errors": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "js-sha512": "^0.9.0",
    "regexparam": "^3.0.0",
    "svelte": "^5.56.6",
    "svelte-preprocess": "^5.1.4"
  },
  "devDependencies": {
    "@binsky/melt": "^0.42.0",
    "@binsky/passman-client-ts": "^0.3.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.1",
    "@types/pouchdb": "^6.4.2",
    "@types/pouchdb-adapter-memory": "^6.1.6",
    "@types/pouchdb-find": "^7.3.3",
    "@types/webextension-polyfill": "^0.12.5",
    "@typescript-eslint/parser": "^8.64.0",
    "@webext-core/messaging": "^2.3.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "autoprefixer": "^10.5.4",
    "eslint-plugin-svelte": "^3.21.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "postcss": "^8.5.19",
    "postcss-rem-to-pixel": "^4.1.2",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "svelte-awesome": "3.3.4",
    "svelte-check": "^4.7.3",
    "svelte-forms": "^2.3.1",
    "svelte-select": "^5.8.3",
    "svelte-time": "^0.9.0",
    "svelty-picker": "^5.2.12",
    "tailwindcss": "^4.3.3",
    "tailwindcss-scoped-preflight": "^3.5.9",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "webextension-polyfill": "^0.12.0",
    "wxt": "^0.20.27"
  },
  "overrides": {
    "@wxt-dev/storage": "1.2.0"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "spawn-sync",
    "svelte-preprocess"
  ]
}
