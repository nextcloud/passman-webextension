{
  "name": "passman-webextension-v3",
  "displayName": "Passman Webextension v3",
  "version": "0.0.3",
  "description": "A modern webextension for the Passman Nextcloud app",
  "author": "Timo Triebensky <timo@binsky.org>",
  "packageManager": "pnpm@8.10.2",
  "scripts": {
    "prebuild": "node ./assets/helper_scripts/update-tld-rules.js",
    "dev": "plasmo dev --verbose",
    "dev-ff": "plasmo dev --target=firefox-mv3",
    "dev-build-ff": "plasmo build --target=firefox-mv3 --no-minify",
    "build": "plasmo build",
    "build-ff": "plasmo build --target=firefox-mv3",
    "package": "plasmo package",
    "package-ff": "plasmo package --target=firefox-mv3"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "idb-keyval": "^6.2.2",
    "js-sha512": "^0.9.0",
    "plasmo": "^0.90.5",
    "regexparam": "^3.0.0",
    "svelte": "^4.2.20",
    "svelte-french-toast": "^1.2.0",
    "svelte-preprocess": "^5.1.4"
  },
  "devDependencies": {
    "@binsky/passman-client-ts": "^0.2.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@melt-ui/pp": "^0.3.2",
    "@melt-ui/svelte": "^0.86.6",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@types/node": "^22.16.5",
    "@types/pouchdb": "^6.4.2",
    "@types/pouchdb-adapter-memory": "^6.1.6",
    "@types/pouchdb-find": "^7.3.3",
    "@types/webextension-polyfill": "^0.12.3",
    "@typescript-eslint/parser": "^8.38.0",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "autoprefixer": "^10.4.21",
    "eslint-plugin-svelte": "^3.11.0",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "svelte-awesome": "3.3.4",
    "svelte-forms": "^2.3.1",
    "svelte-select": "^5.8.3",
    "svelte-time": "^0.9.0",
    "svelty-picker": "^5.2.12",
    "tailwindcss": "^3.4.17",
    "tailwindcss-scoped-preflight": "^3.4.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "webextension-polyfill": "^0.12.0"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "default_locale": "en",
    "permissions": [
      "contextMenus"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/content_styles/*.css",
          "assets/content_styles/*.scss"
        ],
        "matches": [
          "http://*/*",
          "https://*/*"
        ]
      }
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "{5258e630-6a3c-11f0-81fa-a87eea04a880}"
      }
    }
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild",
    "lmdb",
    "msgpackr-extract",
    "sharp",
    "svelte-preprocess"
  ]
}
